@model IEnumerable<Entidades.PA_recPaquetes_Result>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-warning mt-4">@ViewBag.Mensaje</div>
}
else if (Model != null && Model.Any())
{
    <div class="mt-4">
        <table class="table-bordered table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Factura</th>
                    <th>Nombre</th>
                    <th>Tienda</th>
                    <th>Artículo</th>
                    <th>Fecha</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.id_paquete</td>
                        <td>@p.numero_factura</td>
                        <td>@p.nombre_apellidos</td>
                        <td>@p.tienda</td>
                        <td>@p.articulo</td>
                        <td>@p.fecha_envio.ToShortDateString()</td>
                        <td>@p.estado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}


<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rastreo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .navbar {
            background-color: #0C4DA2;
            color: white;
        }

        .main-content {
            flex: 1;
            margin-top: 70px;
            padding: 20px;
        }

        .container-layout {
            display: grid;
            grid-template-columns: 1fr 2fr 1fr;
            grid-gap: 20px;
            max-width: 1200px;
            margin: auto;
        }

        .left-panel, .right-panel, .header, .bottom-panel {
            background: white;
            border: 1px solid #ccc;
            border-radius: 8px;
            padding: 20px;
        }

        .left-panel, .right-panel, .header {
            height: 400px;
        }

        .bottom-panel {
            grid-column: 1 / span 3;
        }

        .logo img {
            height: 50px;
        }

        .search-bar input {
            flex: 1;
            padding: 10px;
        }

        .search-bar {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }

        @@media (max-width: 768px) {
            .container-layout {
                grid-template-columns: 1fr;
                grid-template-rows: auto auto auto auto;
            }

            .left-panel, .right-panel, .header, .bottom-panel {
                height: auto;
            }
        }
    </style>

</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-dark fixed-top">
        <div class="container">
            <span class="navbar-brand">Seguimiento de Paquetes AO</span>
        </div>
    </nav>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <div class="container-layout">

            <!-- PANEL IZQUIERDO -->
            <div class="left-panel">
                <h5>Contactanos</h5>
                <a href="https://wa.me/50686782698" class="btn btn-success d-flex align-items-center" target="_blank">
                    <i class="fab fa-whatsapp me-2"></i> AO Guapiles
                </a>
            </div>

            <!-- PANEL CENTRAL -->
            <div class="header">
                <div class="logo mb-3">
                    <img src="https://www.aostores.com/media/logo/stores/3/Logo_Reestructurado.png" alt="Logo">
                </div>
                <div class="Factura mb-2">Número de factura</div>

                @using (Html.BeginForm("BuscarPorId", "Home", FormMethod.Get))
                {
                    <div class="search-bar">
                        <input type="number" name="id_paquete" class="form-control" placeholder="Número de paquete..." required />
                        <button type="submit" class="btn btn-primary">Buscar</button>
                    </div>
                }
            </div>

            <!-- PANEL DERECHO -->
            <div class="right-panel">Panel Derecho</div>

            <!-- PANEL INFERIOR -->
            <div class="bottom-panel">Panel Inferior</div>
        </div>
    </div>

</body>
</html>

