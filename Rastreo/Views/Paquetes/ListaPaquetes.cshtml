@model IEnumerable<Entidades.PA_recPaquetes_Result>

<p>
    @Html.ActionLink("Crear Un Envio", "CrearPaquetes")
</p>

<input type="text" id="filtro" placeholder="Buscar por nombre, tienda o factura..." class="form-control" style="width:300px; margin-bottom: 15px;" />

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().id_paquete)</th>
            <th>@Html.DisplayNameFor(model => model.First().numero_factura)</th>
            <th>@Html.DisplayNameFor(model => model.First().nombre_apellidos)</th>
            <th>@Html.DisplayNameFor(model => model.First().tienda)</th>
            <th>@Html.DisplayNameFor(model => model.First().articulo)</th>
            <th>@Html.DisplayNameFor(model => model.First().fecha_envio)</th>
            <th>@Html.DisplayNameFor(model => model.First().estado)</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="resultadoTabla">
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.id_paquete</td>
                <td>@item.numero_factura</td>
                <td>@item.nombre_apellidos</td>
                <td>@item.tienda</td>
                <td>@item.articulo</td>
                <td>@item.fecha_envio.ToShortDateString()</td>
                <td>@item.estado</td>
                <td>
                    @Html.ActionLink("Modificar", "modificarunPaquete", new { id_cliente = item.id_paquete })

                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#filtro').on('keyup', function () {
                var filtro = $(this).val();
                $.get('@Url.Action("FiltroPaquetesAjax", "Paquetes")', { filtro: filtro }, function (data) {
                    $('#resultadoTabla').html(data);
                });
            });
        });
    </script>
}



