@model Entidades.paquete

@using (Html.BeginForm("Acciones", "Paquetes", FormMethod.Post, new { enctype = "multipart/form-data", @id = "frmPaquetes" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

        @Html.HiddenFor(model => model.id_paquete)
        @Html.HiddenFor(model => model.numero_factura)
        @Html.HiddenFor(model => model.nombre_apellidos)
        @Html.HiddenFor(model => model.tienda)
        @Html.HiddenFor(model => model.articulo)
        @Html.HiddenFor(model => model.fecha_envio)

        <div class="form-group">
            @Html.LabelFor(model => model.estado, new { @class = "control-label col-md-2" })
            <div class="col-md-10">
                @Html.DropDownListFor(model => model.estado,
                    new SelectList(new[] {
                        "Tienda Origen",
                        "Llegó al CEDI",
                        "Llegó a Sabana",
                        "American Outlet CQ",
                        "Este articulo fue Entregado"
                    }, Model.estado),
                    "Seleccione estado",
                    new { @class = "form-control", required = "required" }
                )
                @Html.ValidationMessageFor(model => model.estado, "", new { @class = "text-danger" })
            </div>
        </div>

        <div class="form-group">
            <div class="col-md-offset-2 col-md-10">
                <button type="submit" name="submitButton" value="Actualizar" class="btn btn-primary">Actualizar</button>
            </div>
        </div>
    </div>
}

<div>
    @Html.ActionLink("Volver", "ListaPaquetes")
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
